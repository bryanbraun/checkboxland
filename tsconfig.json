{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,

    "declaration": true,
    "emitDeclarationOnly": false,
    "declarationMap": true,

    "outDir": "dist",
    "rootDir": "src",

    "types": [],
    "module": "ESNext",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],

    "strict": true,

    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}